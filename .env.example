# Docker / compose
PROJECT_ROOT=.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zapiski
POSTGRES_HOST=zapiski-postgres
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=15s

# Redis
REDIS_PASSWORD=redispass
REDIS_USER=zapiski
REDIS_USER_PASSWORD=zapiski_redis_pass
REDIS_ADDR=zapiski-redis:6379
REDIS_DB=0
REDIS_MAX_RETRIES=5
REDIS_CACHE_TTL=10m

# SSO app
SSO_GRPC_PORT=50051
SSO_SHUTDOWN_TIME=30s
AUTH_JWT_SECRET=change-me-jwt-secret
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_ACCESS_TOKEN_TTL=900s
AUTH_OAUTH_STATE_TTL=10m
AUTH_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:8080/auth/oauth/callback

# Encryption / SMTP (required by SSO config)
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=noreply@example.com
SMTP_ADDR=mailhog:1025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_VERIFICATION_CODE_TIMEOUT=300s

# OAuth Google (required by SSO config)
OAUTH_GOOGLE_CLIENT_ID=dummy
OAUTH_GOOGLE_CLIENT_SECRET=dummy
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/callback

# API gateway
SSO_GRPC_ADDR=sso:50051
API_HTTP_ADDR=:8080
LOGGER_LOG_LEVEL=-4
LOGGER_LEVEL=DEBUG
LOGGER_FOLDER=/tmp/opencode/api-logs
